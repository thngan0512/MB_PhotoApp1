<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#121212"
  tools:context=".ViewArticleActivity">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <ProgressBar
      android:id="@+id/pb_detail_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"
      android:max="100"
      android:layout_marginBottom="10dp" />

    <ImageView
      android:id="@+id/iv_detail"
      android:layout_width="match_parent"
      android:layout_height="350dp"
      android:scaleType="centerCrop"
      tools:srcCompat="@tools:sample/avatars" />

    <TextView
      android:id="@+id/tv_detail_username"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="Username"
      android:textAlignment="center"
      android:textColor="#00E5FF"
      android:textSize="24sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/tv_detail_email"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="Email: user@example.com"
      android:textAlignment="center"
      android:textColor="#B0BEC5"
      android:textSize="16sp" />

    <TextView
      android:id="@+id/tv_detail_hobby"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="Hobby: Photography, Music"
      android:textColor="#FFD54F"
      android:textSize="16sp"
      android:textStyle="italic" />

    <TextView
      android:id="@+id/tv_detail_description"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:lineSpacingMultiplier="1.2"
      android:paddingBottom="40dp"
      android:text="Description..."
      android:textColor="#E0E0E0"
      android:textSize="15sp" />

  </LinearLayout>
</ScrollView>
